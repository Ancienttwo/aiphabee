{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aiphabee-sandbox-bridge-staging",
  "account_id": "ab66185011440a6f8a698d61ad58703a",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-09",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": false,
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1,
      "invocation_logs": true
    }
  },
  "services": [
    {
      "binding": "TOOL_GATEWAY",
      "service": "aiphabee-worker-staging",
      "entrypoint": "SandboxToolGateway"
    }
  ],
  "containers": [
    {
      "class_name": "AiphaBeeSandbox",
      "image": "./Dockerfile",
      "instance_type": "standard-1",
      "max_instances": 20
    },
    {
      "class_name": "ArtifactScannerContainer",
      "image": "./ScannerDockerfile",
      "instance_type": "standard-1",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "AiphaBeeSandbox",
        "name": "AIPHABEE_SANDBOX"
      },
      {
        "class_name": "RunGuard",
        "name": "RUN_GUARD"
      },
      {
        "class_name": "SandboxLeaseRegistryObject",
        "name": "SANDBOX_LEASE_REGISTRY"
      },
      {
        "class_name": "ArtifactScannerContainer",
        "name": "ARTIFACT_SCANNER"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["AiphaBeeSandbox", "RunGuard"],
      "tag": "v1"
    },
    {
      "new_sqlite_classes": ["SandboxLeaseRegistryObject"],
      "tag": "v2"
    },
    {
      "new_sqlite_classes": ["ArtifactScannerContainer"],
      "tag": "v3"
    }
  ],
  "vars": {
    "SANDBOX_TRANSPORT": "rpc"
  }
}
