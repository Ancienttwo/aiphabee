    "concurrent_duplicate_request_transient_until_owner_audit": true
  },
  "expiry": {
    "entitlement": "temporal_authority_valid_to_denies_new_activation",
    "operation_lease": "expired_lease_may_be_reclaimed",
    "public_expire_intent": false
  },
  "activation": {
    "runner_dispatch_enabled": false,
